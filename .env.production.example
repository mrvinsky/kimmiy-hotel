# Copy to .env on the server and fill in every value.
# Generate secrets with: openssl rand -hex 32

# Public domain, without https:// (DNS A record must point to the server)
DOMAIN=example.com

POSTGRES_USER=kimmiy_admin
POSTGRES_PASSWORD=
POSTGRES_DB=kimmiyhotel

JWT_SECRET=
ADMIN_PASSWORD=

# Optional: booking / contact e-mails
# Resend: SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USER=resend, SMTP_PASS=<Resend API key>
# If the server blocks outbound 587 (many VPS providers do), use Resend's alternative port SMTP_PORT=2587
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Kimmiy Hotel
# Sender address on a domain verified in the mail provider, e.g. rezervasyon@example.com
SMTP_FROM=
# Hotel inbox that receives a notification for every new booking request
BOOKING_NOTIFY_EMAIL=
